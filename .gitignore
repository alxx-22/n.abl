# dependencies
node_modules/

# build output
dist/
.vite/

# env — never commit real keys
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# local scratch
*.tmp

# wrangler's local dev state — miniflare's sqlite caches and trace stores,
# rewritten every time check-worker-routes.mjs boots `wrangler dev --local`.
# 1.3MB of it went in with a `git add -A` before this line existed.
.wrangler/

# Lead-sourcing working files: bulk snapshots and candidate lists.
# Large, regenerable, and they hold third-party business data that has
# no reason to be in version control.
.sourcing/
worker/knowledge.generated.ts

# reel contact sheets — regenerate with scripts/reel-sheet.mjs
build/sheets/
