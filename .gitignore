# dependencies
node_modules/

# build output
dist/
.vite/

# env — never commit real keys
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# local scratch
*.tmp

# Lead-sourcing working files: bulk snapshots and candidate lists.
# Large, regenerable, and they hold third-party business data that has
# no reason to be in version control.
.sourcing/

# The public assistant's knowledge, compiled from
# business/03-website/assistant-knowledge.md by scripts/build-knowledge.mjs
# and bundled into the Worker at build time. Generated, so the markdown is
# the source of truth and this would only ever be a stale copy of it.
worker/knowledge.generated.ts
