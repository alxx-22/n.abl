# dependencies
node_modules/

# build output
dist/

# The build-time render bundle. Same status as dist/: produced by
# `vite build --ssr` so scripts/build-routes.mjs can render the public
# routes into their shells, and rewritten on every build.
dist-ssr/
.vite/

# env — never commit real keys
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# local scratch
*.tmp

# wrangler's local dev state — miniflare's sqlite caches and trace stores,
# rewritten every time check-worker-routes.mjs boots `wrangler dev --local`.
# 1.3MB of it went in with a `git add -A` before this line existed.
.wrangler/

# Lead-sourcing working files: bulk snapshots and candidate lists.
# Large, regenerable, and they hold third-party business data that has
# no reason to be in version control.
.sourcing/

# The public assistant's knowledge, compiled from
# business/03-website/assistant-knowledge.md by scripts/build-knowledge.mjs
# and bundled into the Worker at build time. Generated, so the markdown is
# the source of truth and this would only ever be a stale copy of it.
worker/knowledge.generated.ts

# Credentials that belong to a person rather than to the project. Nothing
# here is required to build or deploy; scripts/seo-report.mjs reads its
# Google service-account key from GSC_KEY_FILE and explains itself when
# that is unset, rather than failing.
.secrets/
