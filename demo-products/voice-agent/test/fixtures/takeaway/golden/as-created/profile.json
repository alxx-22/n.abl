 "knowledge": [
  {
   "q": "Do you deliver to me?",
   "a": "Delivery to NG1, NG2, NG3 and NG7 is £2.50, with a £12 minimum; to NG5 and NG9, £3.50 with a £15 minimum. Delivery is free on orders of £30 or more.",
   "tags": ["deliver","delivery","postcode","area","fee","minimum","free delivery"]
  },
  {
   "q": "Do you have any meal deals?",
   "a": "Burger meal, £8.99: Any burger with regular fries and a can. Chicken box, £7.99: Wings, strips, popcorn chicken or two pieces, with fries or onion rings and a can. Pizza night, £19.99: Any two 10-inch pizzas, a garlic bread and two cans.",
   "tags": ["deal","deals","meal","combo","box"]
  },
  {
   "q": "Is your food halal?",
   "a": "Our chicken is halal; our other meat is not.",
   "tags": ["halal","meat","chicken","beef","pork"]
  },
  {
   "q": "Can you cater for allergies?",
   "a": "We cook in a shared kitchen and fryers, so we can't rule out traces of any allergen. Ask about any item and I'll tell you its allergens.",
   "tags": ["allergy","allergies","allergen","intolerance","coeliac"]
  },
  {
   "q": "Do you charge for paying by card?",
   "a": "There's no extra charge for paying by card.",
   "tags": ["card","surcharge","fee","contactless","pay"]
  },
  {
   "q": "Is there parking?",
   "a": "You can park in the bays out front for up to 20 minutes while you collect.",
   "tags": ["parking","car","park"]
  },
  {
   "q": "Do you charge for bags?",
   "a": "Your food comes in a paper bag, at no charge.",
   "tags": ["bag","bags","carrier"]
  },
  {
   "q": "Are you hiring?",
   "a": "We're often looking for drivers and kitchen staff: ask for the manager in the shop.",
   "tags": ["job","jobs","work","hiring","vacancy","apply","driver"]
  },
  {
   "q": "Can I tip the driver?",
   "a": "Tips for the drivers are welcome, and they keep all of them.",
   "tags": ["tip","tips","tipping","driver"]
  },
  {
   "q": "What is your food hygiene rating?",
   "a": "Our food hygiene rating is 5. You can check it on the Food Standards Agency's ratings website.",
   "tags": ["hygiene","rating","clean","inspection","fsa"]
  },
  {
   "q": "Are you on the delivery apps?",
   "a": "Yes, you can order from us on Just Eat.",
   "tags": ["deliveroo","uber","just eat","app","delivery"]
  }
 ],
