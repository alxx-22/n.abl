 "knowledge": [
  {
   "q": "Can we just turn up?",
   "a": "The beer garden and some of the bar are first come; tables can be booked for food. Weekend evenings and Sunday lunch are the busiest, so booking is best then.",
   "tags": ["walk","walk-in","turn up","book","busy","drinks"]
  },
  {
   "q": "Can we sit in the beer garden?",
   "a": "It’s first come, weather permitting: garden tables aren’t booked. Smoking in the beer garden only.",
   "tags": ["garden","outside","beer garden","sun","weather"]
  },
  {
   "q": "When is food served?",
   "a": "Food from 12:30pm until 8:30pm. Drinks until close.",
   "tags": ["food","kitchen","serving","lunch","dinner","roast","sunday"]
  },
  {
   "q": "Can we bring the children?",
   "a": "Children are welcome with an adult until 9pm: there’s a children’s menu and colouring.",
   "tags": ["children","kids","child","family","baby","high chair"]
  },
  {
   "q": "Can we bring the dog?",
   "a": "Dogs are very welcome everywhere, with water bowls in the bar. Assistance dogs always.",
   "tags": ["dog","dogs","pet","puppy","assistance"]
  },
  {
   "q": "Can my 16 or 17-year-old have a drink with a meal?",
   "a": "With a table meal, a 16 or 17-year-old may have beer, wine or cider if an adult with them buys it. Never spirits, never at the bar, and they can’t buy it themselves. Staff will check ID on the night.",
   "tags": ["17","16","seventeen","sixteen","teenager","under 18","drink with a meal","pint with dinner"]
  },
  {
   "q": "What ID do you accept?",
   "a": "We run Challenge 25: anyone who looks under 25 is asked for ID. A passport, a photo driving licence, a PASS card or a certified digital ID app. It’s the staff’s decision on the night.",
   "tags": ["id","identification","challenge 25","passport","driving licence","proof of age","digital id","pass card"]
  },
  {
   "q": "Do you do half pints, small wines and tap water?",
   "a": "Yes: half pints, single 25ml measures and 125ml glasses of wine are always available, and tap water is free.",
   "tags": ["half","half pint","small wine","125","measure","tap water","water","single"]
  },
  {
   "q": "Do you have gluten-free beer?",
   "a": "Yes: Gluten-free lager (bottle), marked gluten-free. Our ales, lagers and stout are brewed with barley or wheat, so they aren’t.",
   "tags": ["gluten","gluten-free","coeliac","celiac","beer","lager"]
  },
  {
   "q": "Is anything on the food menu gluten-free?",
   "a": "We don’t call food gluten-free unless it’s tested: the kitchen uses flour. Some dishes are made without gluten ingredients; the menu says which.",
   "tags": ["gluten","gluten-free","coeliac","celiac","wheat","food"]
  },
  {
   "q": "Can I smoke or vape?",
   "a": "Smoking in the beer garden only. Vaping in the beer garden only, please.",
   "tags": ["smoke","smoking","vape","vaping","cigarette"]
  },
  {
   "q": "Can we bring a birthday cake or our own drinks?",
   "a": "You’re welcome to bring a birthday cake. No drinks of your own, I’m afraid.",
   "tags": ["cake","birthday","own drink","corkage","bring"]
  },
  {
   "q": "Do you show the football?",
   "a": "The big games are on the bar’s screens: ask and I’ll check this week’s list.",
   "tags": ["football","sport","match","game","screen","rugby","cricket","boxing","sky","tnt"]
  },
  {
   "q": "Can you call me a taxi?",
   "a": "We don’t book them, but Lace City Cars (example) on 0115 496 0999.",
   "tags": ["taxi","cab","uber","lift home"]
  },
  {
   "q": "Can we hire the room upstairs?",
   "a": "The Loft upstairs takes up to 40, for parties, wakes and work dos: the manager will call back to talk it through.",
   "tags": ["hire","room","upstairs","loft","function","party","wake","christening","private"]
  },
  {
   "q": "Do you do Christmas parties?",
   "a": "Our Christmas menu is served from late November: the manager will call back to arrange a party.",
   "tags": ["christmas","xmas","festive","office party","work do"]
  },
  {
   "q": "Is it accessible?",
   "a": "Step-free into the bar and the dining room, with an accessible toilet. The Loft is up a flight of stairs.",
   "tags": ["wheelchair","accessible","disabled","step","step-free","toilet","access","stairs"]
  },
  {
   "q": "Is there parking?",
   "a": "No parking of our own; the nearest car park is about five minutes’ walk.",
   "tags": ["parking","car","park"]
  },
  {
   "q": "Do you take cash and card?",
   "a": "Card only, and there’s no extra charge for card. Tips go in the jar, shared by everyone.",
   "tags": ["cash","card","pay","payment","contactless","tip","tips"]
  },
  {
   "q": "What if we’re running late?",
   "a": "We hold a table for 10 minutes; give us a ring if you’ll be later.",
   "tags": ["late","running late","delayed","stuck"]
  },
  {
   "q": "Are you hiring?",
   "a": "We’re often looking for bar and kitchen staff: leave your name and number and the manager will be in touch.",
   "tags": ["job","jobs","hiring","work","vacancy","bar staff"]
  },
  {
   "q": "Can we moor a boat?",
   "a": "Yes, at our jetty, for customers.",
   "tags": []
  }
 ],
