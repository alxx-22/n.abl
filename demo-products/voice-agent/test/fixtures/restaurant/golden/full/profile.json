 "knowledge": [
  {
   "q": "Can I bring my dog?",
   "a": "Dogs are welcome inside and out; we have water bowls.",
   "tags": ["dog","dogs","pet"]
  },
  {
   "q": "Is there parking?",
   "a": "Pay and display on Swinegate, two minutes away.",
   "tags": ["parking","car","park"]
  },
  {
   "q": "Is it accessible for wheelchairs?",
   "a": "Level access, with a ramp at the side door and an accessible toilet.",
   "tags": ["wheelchair","accessible","disabled","step free","accessibility","toilet"]
  },
  {
   "q": "Is there a dress code?",
   "a": "Smart casual.",
   "tags": ["dress","code","smart","wear"]
  },
  {
   "q": "Can I bring my own wine?",
   "a": "Corkage is £15 a bottle, wine only.",
   "tags": ["byo","corkage","wine","bring"]
  },
  {
