 "knowledge": [
  {
   "q": "Can I bring my dog?",
   "a": "Dogs are welcome on the terrace, but not inside, apart from assistance dogs.",
   "tags": ["dog","dogs","pet"]
  },
  {
   "q": "Is there parking?",
   "a": "No car park of our own; the nearest multi-storey is about five minutes’ walk.",
   "tags": ["parking","car","park"]
  },
  {
   "q": "Is it accessible for wheelchairs?",
   "a": "Step-free entrance, level floor throughout the ground floor, and an accessible toilet.",
   "tags": ["wheelchair","accessible","disabled","step free","accessibility","toilet"]
  },
  {
   "q": "Is there a dress code?",
   "a": "No dress code.",
   "tags": ["dress","code","smart","wear"]
  },
  {
