  "knowledge": [
    { "q": "Is there parking?", "a": "There's no car park at the restaurant. Broad Marsh car park is four minutes' walk, and there's on-street pay-and-display on Middle Pavement after 6pm.", "tags": ["parking", "car", "park"] },
    { "q": "Is it accessible for wheelchairs?", "a": "Yes: a step-free entrance, level floor throughout the ground floor, and an accessible toilet.", "tags": ["wheelchair", "accessible", "disabled", "step free", "accessibility"] },
    { "q": "Are dogs allowed?", "a": "Well-behaved dogs are welcome in the front bar area, and we'll bring a water bowl. Assistance dogs are welcome everywhere.", "tags": ["dog", "pet"] },
    { "q": "Are children welcome?", "a": "Yes. We have high chairs and a children's menu of half-size pizzas and pasta for £6.50.", "tags": ["kids", "children", "high chair", "baby", "family"] },
    { "q": "Do you have vegan and vegetarian options?", "a": "Yes: the Vegan Verdure pizza, Penne Arrabbiata and Bruschetta are vegan, and several more dishes are vegetarian.", "tags": ["vegan", "vegetarian", "plant based"] },
    { "q": "Do you do gluten-free?", "a": "We do a gluten-free pizza base for £2 extra. It's cooked in the same oven as our other pizzas, so it isn't suitable for coeliacs.", "tags": ["gluten", "coeliac", "gluten free"] },
    { "q": "Can we bring a birthday cake?", "a": "Yes, you're welcome to bring a cake. There's no charge, and we'll bring it out with candles if you let us know when you book.", "tags": ["birthday", "cake", "celebration"] },
    { "q": "Can we bring our own wine?", "a": "Sorry, we're fully licensed and don't allow bring-your-own.", "tags": ["byo", "corkage", "wine", "alcohol"] },
    { "q": "Do you do private hire?", "a": "The upstairs room seats up to 30 for private parties. The manager handles those, so take the caller's details for a call back.", "tags": ["private", "party", "function", "hire", "upstairs"] },
    { "q": "Do you sell gift vouchers?", "a": "Yes, gift vouchers in any amount, bought in the restaurant.", "tags": ["voucher", "gift"] },
    { "q": "Is there a dress code?", "a": "No dress code. Come as you are.", "tags": ["dress", "clothes"] },
    { "q": "What payment methods do you take?", "a": "All major cards and contactless, Apple Pay and Google Pay. We don't take cheques.", "tags": ["pay", "card", "cash", "contactless"] },
    { "q": "Do you have outdoor seating?", "a": "A small terrace with four tables, weather permitting. Those can't be booked; they're first come, first served.", "tags": ["outside", "outdoor", "terrace", "garden"] },
    { "q": "How do I contact you by email?", "a": "ciao@lucas-trattoria.example", "tags": ["email", "contact"] },
    { "q": "Do you have wifi?", "a": "Yes, free wifi. The password is on the menus.", "tags": ["wifi", "internet"] },
    { "q": "How long do we have the table for?", "a": "Tables are yours for 75 minutes for two, 90 minutes for three or four, and two hours for larger groups.", "tags": ["time limit", "how long", "sitting"] }
