# n.abl Reception: copy to .env.local (gitignored) and fill in.
# Nothing but GEMINI_API_KEY is needed to run locally: without DATABASE_URL the
# server uses PGlite in .data/, and without Twilio every SMS is simulated.

# ── Required ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=                       # Google AI Studio (free tier is fine for demos)
# A key per job, each falling back to GEMINI_API_KEY. Give a job its own key
# (from its own Google Cloud project) when it needs its own quota:
# GEMINI_API_KEY_CALLS=                # live calls, voice previews, the turn-taking listener
# GEMINI_API_KEY_SCOUT=                # reading prospects' websites
# GEMINI_API_KEY_TEXT=                 # call summaries, menu and FAQ drafts

# ── Voice models (defaults shown) ─────────────────────────────────────────
# LIVE_MODEL_PRIMARY=gemini-3.1-flash-live-preview
# LIVE_MODEL_FALLBACKS=gemini-3.8-live
# TEXT_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# CALLER_MODEL=gemini-3.8-live         # the simulated caller in npm run eval
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TRANSCRIBE_MODEL=gemini-3.5-transcribe-live  # hears the caller's words for turn-taking; off to disable
# VAD_SILENCE_MS=600
# COMPRESS_AT_TOKENS=12000
# COMPRESS_TO_TOKENS=7000
# MAX_CALL_SECONDS=720
# MAX_CONCURRENT_CALLS=6               # free tier: about 2 busy calls per model at once

# ── Database ──────────────────────────────────────────────────────────────
# The shared Supabase project (auivrancfnrdwyiqoakt). Use the session pooler
# connection string (Project Settings → Database → Connect), which works over
# IPv4. Leave unset to use PGlite locally.
# DATABASE_URL=postgresql://postgres.auivrancfnrdwyiqoakt:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# PGLITE_DIR=.data/pglite

# ── Server ────────────────────────────────────────────────────────────────
# PORT=8787
# PUBLIC_BASE_URL=https://nabl-reception.fly.dev   # needed for Twilio webhooks
# CONSOLE_PASSWORD=                    # set this anywhere the console is reachable
# SESSION_SECRET=                      # any long random string; signs cookies and stream tokens

# ── Demo payments ─────────────────────────────────────────────────────────
# number:expiry:cvc:approve|decline, comma separated
# DEMO_CARDS=1234567890123456:12/34:123:approve,1234567800000000:12/34:123:decline

# ── Twilio (Phase 5) ──────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=                   # verifies webhook signatures
# TWILIO_API_KEY=                      # optional: REST calls with an API key instead of the auth token
# TWILIO_API_SECRET=
# TWILIO_SMS_FROM=                     # a number or alphanumeric sender ID; unset = SMS simulated
# PIN_ROUTER_FALLBACK=1                # unknown numbers get the PIN prompt instead of a refusal
