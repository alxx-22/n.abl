# Security headers and cache policy, in the format Cloudflare Pages reads
# natively from the build output.
#
# These lived only in netlify.toml, which Cloudflare does not read — so moving
# host without this file would have quietly dropped every one of them. The
# site would have looked identical and served no CSP, no HSTS and no
# X-Frame-Options. scripts/check-headers.mjs asserts this file and
# netlify.toml still agree, so the two cannot drift while both hosts exist.
#
# Order matters: Cloudflare applies every matching rule, most specific last.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://rrkcoqopcqtowbyismcq.supabase.co https://api.web3forms.com; upgrade-insecure-requests

# Hashed filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must not be cached, or a deploy ships new assets behind an old
# index that still references the previous hashes.
/index.html
  Cache-Control: no-cache
