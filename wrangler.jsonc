{
  // Serving the built site from Workers Static Assets.
  //
  // The first deploy failed because there was no config here: wrangler
  // auto-detected Vite and tried to wire up the Cloudflare Vite plugin, which
  // needs Vite 6 and this project is on 5.4. Declaring the project explicitly
  // stops the guessing. Nothing here needs the plugin — the build already
  // produces a directory of static files, and this uploads it.
  //
  // There is no "main" and no "binding" on purpose. Both are only valid with a
  // Worker script, and this site has none: every route is either a file or the
  // SPA shell.
  "name": "n-abl",
  "compatibility_date": "2026-08-22",

  // The public assistant. Static assets are matched first, so every real file
  // is served without this script running at all — only /api/* reaches it.
  "main": "./worker/index.ts",

  // No AI binding. The public assistant calls Groq, whose free tier carries an
  // order of magnitude more traffic than Workers AI's daily Neuron allowance —
  // which matters when the audience is anyone who finds the site. The key is a
  // Worker secret:
  //     npx wrangler secret put GROQ_API_KEY
  //
  // The CLIENT assistant, when it is built, goes the other way: it handles
  // client personal data, and Cloudflare is already a processor of that, so
  // Workers AI adds no sub-processor where Groq would.

  "assets": {
    "directory": "./dist",

    // React Router owns /crm, /portal, /team and the rest, so a request for a
    // path with no matching file has to return index.html rather than a 404.
    // Pages inferred this from the presence of index.html; Workers makes it
    // explicit, which the migration guide notes is deliberate — inference is
    // how a misconfiguration goes unnoticed.
    //
    // There is no _redirects file any more, and this is what replaced it.
    //
    // It carried the same four rules netlify.toml already has, and Cloudflare
    // rejected the deploy over the last one:
    //
    //   Line 6: Infinite loop detected in this rule. This would cause a
    //   redirect to strip `.html` or `/index` and end up triggering this rule
    //   again.
    //
    // Which is correct. `/* -> /index.html` asks Workers to rewrite to a path
    // it then normalises straight back to `/`, matching `/*` again. The other
    // three rules — /privacy, /terms, /cookies to their index.html — would
    // loop the same way, and are unnecessary regardless: html_handling
    // defaults to "auto-trailing-slash", which already resolves /privacy to
    // /privacy/index.html.
    //
    // So the file was deleted rather than patched. Netlify keeps working
    // because netlify.toml has always carried the identical four rules; the
    // _redirects file was pure duplication of it.
    "not_found_handling": "single-page-application"
  }
}
