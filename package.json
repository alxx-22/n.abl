{
  "name": "nabl",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "n.abl — agency site, client portal, team space and CRM",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-css-tokens.mjs && node scripts/check-headers.mjs && node scripts/build-knowledge.mjs && vite build && vite build --ssr src/prerender.jsx --outDir dist-ssr && node scripts/build-routes.mjs && node scripts/check-seo.mjs",
    "preview": "vite preview --port 4173",
    "test:ui": "node scripts/e2e-ui.mjs",
    "test:motion": "node scripts/e2e-motion.mjs",
    "test:live": "node scripts/e2e-live.mjs",
    "test:security": "node scripts/security-check.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:seo:live": "node scripts/check-seo.mjs --live",
    "seo:report": "node scripts/seo-report.mjs",
    "test:hooks": "node scripts/sourcing/hooks-test.mjs",
    "test:scan": "node scripts/sourcing/scan-test.mjs",
    "sourcing:observe": "node --env-file-if-exists=.env.local scripts/sourcing/observe.mjs",
    "sourcing:write": "node --env-file-if-exists=.env.local scripts/sourcing/scan.mjs",
    "sourcing:write:dry": "node --env-file-if-exists=.env.local scripts/sourcing/scan.mjs --dry-run",
    "test:emails": "node scripts/check-email-contrast.mjs",
    "test:compliance": "node scripts/check-compliance-schema.mjs",
    "test:css": "node scripts/check-css-tokens.mjs",
    "test:headers": "node scripts/check-headers.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:routes": "node scripts/check-worker-routes.mjs",
    "test:portal-assistant": "node scripts/e2e-portal-assistant.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.106.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "vite": "^5.4.8"
  }
}
