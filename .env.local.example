# Copy to .env.local and fill in. .env.local is gitignored; this example is not,
# so never put a real value in this file.
#
# The npm scripts load .env.local with node --env-file-if-exists, so once it is
# here nothing needs exporting and nothing needs passing on the command line.

# Google AI Studio, for scripts/sourcing/scan.mjs — the stage that writes each
# lead's observation. Free, no card: aistudio.google.com/apikey
GEMINI_API_KEY=

# What your AI Studio dashboard actually shows for the model you are using.
# Google stopped publishing these, so the defaults in scan.mjs (15/min, 200/day)
# are a conservative guess. Setting them right is the difference between a run
# that finishes and one that stops halfway.
GEMINI_RPM=
GEMINI_RPD=

# Google Search Console ownership token, for the site build. Search Console →
# add property → HTML tag, then copy just the content value out of the tag.
GSC_VERIFICATION=
